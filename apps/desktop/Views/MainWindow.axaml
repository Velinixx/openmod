<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenMod.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="OpenMod.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="openmod"
        Width="1280" Height="800"
        MinWidth="1040" MinHeight="620"
        Background="{DynamicResource BgBrush}"
        FontFamily="{DynamicResource UiFont}">

    <Grid RowDefinitions="56,*,64" ColumnDefinitions="208,*,312">

        <!-- ======================== TOP BAR ======================== -->
        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,0">

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentGradientBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="2.5" Height="8" CornerRadius="1.2" Background="{DynamicResource OnAccentBrush}" Opacity="0.85" />
                            <Border Width="2.5" Height="14" CornerRadius="1.2" Background="{DynamicResource OnAccentBrush}" Opacity="0.85" />
                            <Border Width="2.5" Height="10" CornerRadius="1.2" Background="{DynamicResource OnAccentBrush}" Opacity="0.85" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="open" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="mod" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Classes="voice-toggle"
                        Classes.on="{Binding IsVoiceOn}"
                        Width="208" Height="34"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Command="{Binding ToggleVoiceCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding VoiceToggleText}" FontSize="11.5" FontWeight="Bold"
                                   LetterSpacing="1.3" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Height="28" CornerRadius="14" Padding="14,0"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding LatencyText}" Classes="mono" FontSize="10.5"
                                   Foreground="{DynamicResource SoftBrush}" VerticalAlignment="Center" />
                    </Border>

                    <Button Classes="icon" Command="{Binding CycleThemeCommand}" ToolTip.Tip="Theme: system / light / dark / amoled">
                        <Grid Width="16" Height="16">
                            <Ellipse Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" />
                            <Path Data="{DynamicResource IconThemeHalf}" Width="16" Height="16"
                                  Fill="{DynamicResource MutedBrush}" />
                        </Grid>
                    </Button>

                    <Button Classes="icon">
                        <Grid Width="16" Height="16">
                            <Path Data="M1.5,4 H14.5 M1.5,12 H14.5 M5.5,1.5 V6.5 M11,9.5 V14.5"
                                  Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4"
                                  StrokeLineCap="Round" />
                        </Grid>
                    </Button>

                    <Border Width="24" Height="24" CornerRadius="12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Background="{DynamicResource CardBrush}">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource MutedBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================== SIDEBAR ======================== -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">

                <StackPanel Margin="20,32,20,0">
                    <TextBlock Text="WORKSPACE" Classes="section" />

                    <ItemsControl ItemsSource="{Binding Nav}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItemViewModel">
                                <Border Classes="nav" Classes.on="{Binding IsActive}"
                                        Height="38" CornerRadius="9" Margin="-8,0,-8,8">
                                    <Grid>
                                        <Border Classes="accentbar" Width="3" Height="26" CornerRadius="1.5"
                                                Background="{DynamicResource AccentBrush}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="20,0,0,0"
                                                    VerticalAlignment="Center">
                                            <Path Data="{Binding IconData}" Width="16" Height="16"
                                                  StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" />
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,20" />
                    <TextBlock Text="EFFECTS" Classes="section" />

                    <ItemsControl ItemsSource="{Binding EffectRegistry}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EffectRegistryItemViewModel">
                                <Border Classes="reg" Classes.on="{Binding IsUsed}" Height="20">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Ellipse Width="5.2" Height="5.2" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="mono" FontSize="10.5"
                                                   Margin="14,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20,0,20" />
                    <TextBlock Text="FOLDERS" Classes="section" />

                    <ItemsControl ItemsSource="{Binding Folders}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderItemViewModel">
                                <Grid ColumnDefinitions="*,Auto" Height="20">
                                    <TextBlock Text="{Binding Name}" Classes="mono" FontSize="10.5"
                                               Foreground="{DynamicResource SoftBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Info}" Classes="mono" FontSize="9.5"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- virtual mic card + project footer -->
                <StackPanel Grid.Row="2" Margin="20,0,20,18">
                    <Border CornerRadius="10" Padding="12" Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="VIRTUAL MIC" FontSize="8.5" FontWeight="SemiBold" LetterSpacing="1.2"
                                           Classes="muted" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Height="16" CornerRadius="8" Padding="8,0"
                                        Background="{DynamicResource AccentSoftStrongBrush}"
                                        BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="LIVE" FontSize="8" FontWeight="Bold" LetterSpacing="0.8"
                                               Classes="accent" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="6.8" Height="6.8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OutputDevice}" Classes="mono" FontSize="10.5" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="pick as mic in games" FontSize="9" Classes="muted" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Velinixx/openmod" Classes="mono" FontSize="9.5" Classes.muted="True" Margin="4,16,0,0" />
                    <TextBlock Text="MIT · v0.1.0" Classes="mono" FontSize="9" Classes.faint="True" Margin="4,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================== CONTENT ======================== -->
        <ScrollViewer Grid.Row="1" Grid.Column="1"
                      Padding="28,28,0,20"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel>
                        <TextBlock Text="My Voices" Classes="h1" />
                        <TextBlock Text="{Binding VoicesSubtitle}" FontSize="11.5" Classes="muted" Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1" Width="196" Height="34" CornerRadius="9" Margin="0,4,12,0"
                            VerticalAlignment="Top"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*" Margin="14,0">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Margin="1,1,0,0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" />
                                <Path Data="{DynamicResource IconSearch}" Width="16" Height="16"
                                      Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" StrokeLineCap="Round" />
                            </Grid>
                            <TextBlock Grid.Column="1" Text="Search voices…" FontSize="11" Classes="muted"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Button Grid.Column="2" Classes="outline" Content="+ New" Height="34" Padding="18,0"
                            Margin="0,4,20,0" VerticalAlignment="Top" />
                </Grid>

                <!-- voice cards (metadata-only until hydrated) -->
                <ItemsControl ItemsSource="{Binding Voices}" Margin="0,22,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>

                        <DataTemplate DataType="vm:VoiceCardViewModel" x:DataType="vm:VoiceCardViewModel">
                            <Border Classes="voicecard" Classes.on="{Binding IsActive}"
                                    Width="224" Height="152" CornerRadius="12" Margin="0,0,20,16">
                                <Grid RowDefinitions="36,Auto,Auto,*" Margin="16,14,16,12">

                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Classes="badge" Width="36" Height="36" CornerRadius="10">
                                            <StackPanel Orientation="Horizontal" Spacing="2.5"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="2.5" Height="8" CornerRadius="1.2" Background="{DynamicResource AccentTextBrush}" />
                                                <Border Width="2.5" Height="14" CornerRadius="1.2" Background="{DynamicResource AccentTextBrush}" />
                                                <Border Width="2.5" Height="10" CornerRadius="1.2" Background="{DynamicResource AccentTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Classes="livepill" Height="18" CornerRadius="9"
                                                Padding="9,0" VerticalAlignment="Top"
                                                IsVisible="{Binding IsActive}">
                                            <TextBlock Text="● LIVE" FontSize="8" FontWeight="Bold" LetterSpacing="0.6"
                                                       Classes="accent" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                               Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />

                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Chips}" Margin="0,9,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8.5" Padding="8,3"
                                                        Background="{DynamicResource DeepBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding}" Classes="mono" FontSize="9"
                                                               Foreground="{DynamicResource SoftBrush}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Grid.Row="3" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding LatencyText}" Classes="mono" FontSize="8.5"
                                                   Classes.muted="True" />
                                        <TextBlock Text="edit ›" FontSize="9" Classes="muted"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>

                        <DataTemplate DataType="vm:NewVoiceCardViewModel">
                            <Grid Width="224" Height="152" Margin="0,0,20,16" Cursor="Hand">
                                <Rectangle RadiusX="12" RadiusY="12"
                                           Stroke="{DynamicResource BorderBrush}" StrokeThickness="1"
                                           StrokeDashArray="5,5" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                                    <Border Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center"
                                            BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1.2" Opacity="0.85">
                                        <Path Data="{DynamicResource IconPlus}" Width="14" Height="14"
                                              Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6"
                                              StrokeLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="New voice" FontSize="13" FontWeight="SemiBold"
                                                   Classes="soft" HorizontalAlignment="Center" />
                                        <TextBlock Text="JSON or code" Classes="mono" FontSize="9.5"
                                                   Classes.muted="True" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>

                    </ItemsControl.DataTemplates>
                </ItemsControl>

                <!-- community -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,6,20,10">
                    <TextBlock Text="COMMUNITY PRESETS" Classes="section" />
                    <TextBlock Grid.Column="1" Text="browse on GitHub ↗" FontSize="9.5" Classes="accent" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Community}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CommunityPresetViewModel">
                            <Border CornerRadius="10" Height="46" Margin="0,0,20,8" Padding="16,0"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{Binding Name}" Classes="mono" FontSize="11.5" />
                                        <TextBlock Text="{Binding Detail}" FontSize="9.5" Classes="muted" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="outline" Content="+ Add" Height="26" Padding="12,0"
                                            CornerRadius="8" FontSize="9.5" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ======================== CHAIN PANEL ======================== -->
        <Border Grid.Row="1" Grid.Column="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <ScrollViewer Padding="24,32,24,24" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <TextBlock Text="ACTIVE CHAIN" Classes="section" />

                    <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                        <TextBlock Text="{Binding ActiveChainName}" Classes="h2" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="1" Width="44" Height="24" CornerRadius="12" Cursor="Hand"
                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                            <Ellipse Width="16" Height="16" Fill="{DynamicResource OnAccentBrush}"
                                     HorizontalAlignment="Right" Margin="0,0,4,0" Opacity="0.9" />
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Chain}" Margin="0,18,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChainEffectViewModel">
                                <Border CornerRadius="10" Height="112" Margin="0,0,0,12"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16,12,16,10">

                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Text="⠿" FontSize="13" Classes="muted" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="mono" FontSize="11.5"
                                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="✕" FontSize="9" Classes="muted"
                                                       VerticalAlignment="Center" Cursor="Hand" />
                                        </Grid>

                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                                            <TextBlock Text="{Binding ParamLabel}" Classes="mono" FontSize="9.5"
                                                       Classes.muted="True" />
                                            <TextBlock Grid.Column="1" Text="{Binding ParamValue}" Classes="mono"
                                                       FontSize="10.5" Classes.accent="True" />
                                        </Grid>

                                        <Canvas Grid.Row="2" Height="18" Margin="0,6,0,0">
                                            <Border Canvas.Left="0" Canvas.Top="7" Width="232" Height="4" CornerRadius="2"
                                                    Background="{DynamicResource TrackBrush}" />
                                            <Border Canvas.Left="0" Canvas.Top="7" Height="4" CornerRadius="2"
                                                    Width="{Binding FillWidth}"
                                                    Background="{DynamicResource AccentMeterBrush}" />
                                            <Ellipse Canvas.Left="{Binding KnobX}" Canvas.Top="2.5" Width="13" Height="13"
                                                     Fill="{DynamicResource KnobBrush}"
                                                     Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                                        </Canvas>

                                        <TextBlock Grid.Row="3" Text="drag to reorder · remove" Classes="mono"
                                                   FontSize="8" Classes.faint="True" VerticalAlignment="Bottom" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Height="40" Margin="0,2,0,0" Cursor="Hand">
                        <Rectangle RadiusX="10" RadiusY="10" Stroke="{DynamicResource BorderBrush}"
                                   StrokeThickness="1" StrokeDashArray="5,5" />
                        <TextBlock Text="+ add effect" FontSize="10.5" Classes="muted"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,28,0,22" />
                    <TextBlock Text="STATS" Classes="section" />

                    <ItemsControl ItemsSource="{Binding Stats}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatRowViewModel">
                                <Grid ColumnDefinitions="*,Auto" Height="24">
                                    <TextBlock Text="{Binding Label}" FontSize="10" Classes="muted" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="10.5"
                                               Foreground="{DynamicResource SoftBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,22,0,22" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Button Classes="ghost" Content="Save preset" Height="34" CornerRadius="9"
                                HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Classes="outline" Content="Export JSON" Height="34" Padding="18,0" />
                    </Grid>

                    <TextBlock Text="{Binding PresetPath}" Classes="mono" FontSize="9" Classes.faint="True"
                               Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ======================== BOTTOM BAR ======================== -->
        <Border Grid.Row="2" Grid.ColumnSpan="3"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="20,0">

                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" Width="210">
                    <Path Data="{DynamicResource IconMic}" Width="16" Height="16"
                          Stroke="{DynamicResource SoftBrush}" StrokeThickness="1.4" StrokeLineCap="Round"
                          VerticalAlignment="Center" />
                    <StackPanel Spacing="3">
                        <TextBlock Text="INPUT" FontSize="8.5" FontWeight="SemiBold" LetterSpacing="1.2" Classes="muted" />
                        <TextBlock Text="{Binding InputDevice}" FontSize="10.5" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Width="232" Height="40" CornerRadius="10" Margin="30,0,0,0"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*" Margin="16,0">
                        <StackPanel Orientation="Horizontal" Spacing="2.5" VerticalAlignment="Center">
                            <Border Width="2" Height="7" CornerRadius="1" Background="{DynamicResource AccentTextBrush}" />
                            <Border Width="2" Height="13" CornerRadius="1" Background="{DynamicResource AccentTextBrush}" />
                            <Border Width="2" Height="9" CornerRadius="1" Background="{DynamicResource AccentTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="OUTPUT" FontSize="8.5" FontWeight="SemiBold" LetterSpacing="1.2"
                                       Classes="accent" />
                            <TextBlock Text="{Binding OutputDevice}" Classes="mono" FontSize="10.5" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Spacing="7" VerticalAlignment="Center" Margin="44,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="IN" FontSize="8.5" FontWeight="SemiBold" Classes="muted"
                                   Width="22" TextAlignment="Right" VerticalAlignment="Center" />
                        <Grid Width="120" Height="5">
                            <Border Background="{DynamicResource TrackBrush}" CornerRadius="2.5" />
                            <Border Width="{Binding InMeterWidth}" HorizontalAlignment="Left" CornerRadius="2.5"
                                    Background="{DynamicResource AccentMeterBrush}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="OUT" FontSize="8.5" FontWeight="SemiBold" Classes="muted"
                                   Width="22" TextAlignment="Right" VerticalAlignment="Center" />
                        <Grid Width="120" Height="5">
                            <Border Background="{DynamicResource TrackBrush}" CornerRadius="2.5" />
                            <Border Width="{Binding OutMeterWidth}" HorizontalAlignment="Left" CornerRadius="2.5"
                                    Background="{DynamicResource AccentMeterBrush}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="VOL" FontSize="8.5" FontWeight="SemiBold" Classes="muted" VerticalAlignment="Center" />
                        <Canvas Width="120" Height="16" VerticalAlignment="Center">
                            <Border Canvas.Left="0" Canvas.Top="5.5" Width="120" Height="5" CornerRadius="2.5"
                                    Background="{DynamicResource TrackBrush}" />
                            <Border Canvas.Left="0" Canvas.Top="5.5" Height="5" CornerRadius="2.5"
                                    Width="{Binding VolumeWidth}" Background="{DynamicResource SoftBrush}" />
                            <Ellipse Canvas.Left="{Binding VolumeKnobX}" Canvas.Top="2" Width="12" Height="12"
                                     Fill="{DynamicResource KnobBrush}"
                                     Stroke="{DynamicResource TrackBrush}" StrokeThickness="1.2" />
                        </Canvas>
                    </StackPanel>

                    <Button Width="124" Height="40" CornerRadius="10" Padding="0"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding ToggleMonitorCommand}"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*" Margin="14,0">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Path Data="{DynamicResource IconHeadphones}" Width="16" Height="16"
                                      Stroke="{DynamicResource SoftBrush}" StrokeThickness="1.4" StrokeLineCap="Round" />
                                <Border Width="3" Height="6" CornerRadius="1.2" Background="{DynamicResource SoftBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,0" />
                                <Border Width="3" Height="6" CornerRadius="1.2" Background="{DynamicResource SoftBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,0" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="MONITOR" FontSize="8.5" FontWeight="SemiBold" LetterSpacing="1.1"
                                           Classes="muted" />
                                <TextBlock Text="{Binding MonitorText}" Classes="mono" FontSize="10.5"
                                           Foreground="{DynamicResource SoftBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <Button Grid.Column="5" Classes="primary" Width="104" Height="40" CornerRadius="10"
                        Margin="20,0,0,0" Command="{Binding StopCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="12" Height="12" CornerRadius="2" Background="White" Opacity="0.95" />
                        <TextBlock Text="Stop" FontSize="11.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
